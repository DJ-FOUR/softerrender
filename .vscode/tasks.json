{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "首次配置（MinGW + Ninja）",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_CXX_COMPILER=D:/mingw64/bin/g++.exe",
                "-DCMAKE_MAKE_PROGRAM=D:/mingw64/bin/ninja.exe"
            ],
            "problemMatcher": []
        },
        {
            "label": "构建",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "运行",
            "type": "shell",
            "command": "${workspaceFolder}/build/renderer.exe",
            "problemMatcher": []
        }
    ]
}
